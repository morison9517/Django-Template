# =============================================================================
# .env の見本(これはGitHubに上がる。.env 本体は上がらない)
#
#   初回だけ、これをコピーして .env を作る:
#     Windows: Copy-Item .env.example .env
#     Mac:     cp .env.example .env
#
#   ★項目を増やしたら、このファイルにも同じ項目を書き足すこと。
#     見本が古いと、他の人が起動できなくなる。
# =============================================================================

# --- アプリの設定 ---
# DJANGO_SECRET_KEY: ログイン状態をブラウザに預けるときの「割り印」。
#                    漏れるとログイン状態を偽造されるので、本番では必ず変更する。
DJANGO_SECRET_KEY=please-change-this-to-a-long-random-string

# True  = 開発用。エラーの原因が画面に出る + CSSや画像をDjangoが配る
# False = 本番用。エラーの中身を隠す(内部情報が漏れるため)+ CSSはNginxが配る
#
#   ★開発中に False にすると、デザインが全部消えて、原因も表示されなくなります。
#     開発用の compose.yml には Nginx がいないので、CSSを配る人が誰もいなくなるためです。
#
#   ★「保存したら反映される」は runserver というコマンドの機能で、この設定とは無関係です。
#     本番で反映されないのは、箱にコードを焼き込んで動かしているからです(docs/DEPLOY.md)。
DJANGO_DEBUG=True

# アクセスを許可するドメイン。カンマ区切り。
# 本番でサブドメインを使うときは、ここに追記する(例: app.example.com)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- ここから下は本番(compose.prod.yml)でだけ使う ---
#     開発中は書かなくて構いません。手順は docs/DEPLOY.md

# HTTPSで公開するドメイン(例: app.example.com)。https:// は付けない。
# ★空のあいだはHTTPで動きます。書いた瞬間にHTTPSへ切り替わります。
# ★証明書を取ってから書くこと。先に書くと Nginx が起動しません(手順は docs/DEPLOY.md)。
#   ★Django版は、ここに書いたドメインを「許可するドメイン」と「フォームの送信元」にも
#     自動で足します(DJANGO_ALLOWED_HOSTS と DJANGO_CSRF_TRUSTED_ORIGINS に書かなくてよい)。
HTTPS_DOMAIN=

# フォームの送信を許可する送信元。https:// から書く。
# ★HTTPS_DOMAIN に書いたドメインは自動で入るので、普通は空のままでよい。
#   www. 付きなど、別のURLからも送信させたいときだけ書く。
# 例: DJANGO_CSRF_TRUSTED_ORIGINS=https://www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# ログイン状態を HTTPS のときだけ持ち歩く設定。本番は True のままにする。
# ★まだ HTTPS にしていない練習中だけ False にする。
#   True のまま http:// で開くと、ログインしても必ずログイン画面に戻されます。
DJANGO_SECURE_COOKIES=True

# --- データベースの設定 ---
# DB_HOST: Dockerの中では compose.yml のサービス名 "db" がそのまま住所になる。
DB_HOST=db
DB_PORT=3306
DB_NAME=hack_app
DB_USER=hack_user
DB_PASSWORD=hack_password
DB_ROOT_PASSWORD=root_password

# --- 機能のON/OFF ---
# False にすると、ログイン関連の受付(URL)を登録しなくなる。
AUTH_ENABLED=True
